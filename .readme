script para base de datos en mysql:

CREATE DATABASE IF NOT EXISTS tooeasy CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE tooeasy;

CREATE TABLE skins (
  id VARCHAR(100) PRIMARY KEY,
  tipo ENUM('house','beaver') NOT NULL,
  nombre VARCHAR(150) NOT NULL,
  imagen VARCHAR(512) NOT NULL,
  unlock_level TINYINT UNSIGNED DEFAULT 0
) ENGINE=InnoDB;

CREATE TABLE levels (
  id TINYINT UNSIGNED PRIMARY KEY,
  nombre VARCHAR(100),
  preguntas_count TINYINT UNSIGNED DEFAULT 5,
  reward_coins INT UNSIGNED DEFAULT 20
) ENGINE=InnoDB;


CREATE TABLE users (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL UNIQUE,
  password_hash VARCHAR(255),
  edad TINYINT UNSIGNED,
  genero VARCHAR(20),
  foto VARCHAR(512) DEFAULT NULL,
  
  -- Economía
  coins INT UNSIGNED DEFAULT 0,
  wood INT UNSIGNED DEFAULT 0,
  
  -- Progreso
  level TINYINT UNSIGNED DEFAULT 1,
  house_level TINYINT UNSIGNED DEFAULT 1,
  beaver_level TINYINT UNSIGNED DEFAULT 1,

  -- Apariencia
  current_appearance VARCHAR(100) DEFAULT 'skin_default',
  current_beaver VARCHAR(100) DEFAULT 'castor_default',

  -- Estado
  is_active BOOLEAN DEFAULT TRUE,
  
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

  FOREIGN KEY (current_appearance) REFERENCES skins(id) ON UPDATE CASCADE,
  FOREIGN KEY (current_beaver) REFERENCES skins(id) ON UPDATE CASCADE
) ENGINE=InnoDB;



CREATE TABLE user_skins (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT UNSIGNED NOT NULL,
  skin_id VARCHAR(100) NOT NULL,
  unlocked_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY ux_user_skin (user_id, skin_id),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  FOREIGN KEY (skin_id) REFERENCES skins(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE user_levels (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT UNSIGNED NOT NULL,
  level_id TINYINT UNSIGNED NOT NULL,
  completed BOOLEAN DEFAULT FALSE,
  completed_at TIMESTAMP NULL,
  reward_claimed BOOLEAN DEFAULT FALSE,
  reward_coins INT UNSIGNED DEFAULT 0,
  UNIQUE KEY ux_user_level (user_id, level_id),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  FOREIGN KEY (level_id) REFERENCES levels(id) ON DELETE CASCADE
) ENGINE=InnoDB;


CREATE TABLE user_challenges (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT UNSIGNED NOT NULL,
  challenge_id INT UNSIGNED NOT NULL,
  progress INT UNSIGNED DEFAULT 0,
  claimed BOOLEAN DEFAULT FALSE,
  claimed_at TIMESTAMP NULL,
  UNIQUE KEY ux_user_challenge (user_id, challenge_id),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;


CREATE TABLE dashboard_fixed (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT UNSIGNED NOT NULL UNIQUE,
  ingreso_fijo DECIMAL(10,2) DEFAULT 0.00,
  egreso_fijo DECIMAL(10,2) DEFAULT 0.00,
  meta_nombre VARCHAR(200),
  meta_cantidad DECIMAL(10,2) DEFAULT 0.00,
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE movements (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT UNSIGNED NOT NULL,
  fecha DATE NOT NULL,
  tipo ENUM('income','expense') NOT NULL,
  categoria VARCHAR(200) DEFAULT 'General',
  monto DECIMAL(65,2) NOT NULL,
  descripcion TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  INDEX ix_user_fecha (user_id, fecha),
  INDEX ix_user_tipo (user_id, tipo)
) ENGINE=InnoDB;


CREATE TABLE password_resets (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT UNSIGNED NOT NULL,
  token_hash VARCHAR(255) NOT NULL,
  expires_at DATETIME NOT NULL,
  used BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  INDEX ix_token (token_hash)
) ENGINE=InnoDB;

CREATE TABLE auth_providers (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT UNSIGNED NOT NULL,
  provider ENUM('google','facebook','github') NOT NULL,
  provider_user_id VARCHAR(255) NOT NULL,
  provider_email VARCHAR(255),
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY ux_provider_user (provider, provider_user_id),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;


create table challenges(
id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT UNSIGNED NOT NULL,
  challenge_id INT UNSIGNED NOT NULL,
  progress INT UNSIGNED DEFAULT 0,
  claimed BOOLEAN DEFAULT FALSE,
  claimed_at TIMESTAMP NULL,
  UNIQUE KEY ux_user_challenge (user_id, challenge_id),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
)ENGINE=InnoDB;


ALTER TABLE users 
ADD COLUMN dashboard_balance DECIMAL(12,2) DEFAULT 0.00 
AFTER coins;

ALTER TABLE users 
ADD COLUMN email VARCHAR(255) UNIQUE NOT NULL AFTER nombre;

ALTER TABLE users
ADD avatar VARCHAR(100);

