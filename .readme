-- 1. Tabla de categorías (FIJAS, no se pueden crear más)
CREATE TABLE IF NOT EXISTS learning_categories (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    descripcion TEXT,
    orden INT NOT NULL,
    nivel_inicio INT NOT NULL,
    nivel_fin INT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Insertar las 5 categorías fijas
INSERT INTO learning_categories (nombre, descripcion, orden, nivel_inicio, nivel_fin) VALUES
('Fundamentos', 'Aprende los conceptos básicos del dinero: qué son los ingresos y gastos, cómo ahorrar correctamente y la importancia de contar con un fondo de emergencia.', 1, 1, 3),
('Cuentas Bancarias', 'Conoce los distintos tipos de cuentas bancarias, cómo abrir tu primera cuenta, manejar tu nómina y entender los intereses y comisiones.', 2, 4, 6),
('Tarjetas', 'Descubre cómo funcionan las tarjetas de débito y crédito, sus diferencias, tipos disponibles y cómo utilizarlas de manera segura.', 3, 7, 10),
('Administración de Dinero', 'Aprende a organizar tus ingresos, aplicar la regla 50/30/20, elaborar presupuestos inteligentes y controlar tus gastos.', 4, 11, 13),
('Deudas y Créditos', 'Conoce cómo funciona tu historial crediticio, identifica la diferencia entre deuda buena y mala, y aprende cómo construir un buen historial financiero.', 5, 14, 17);

-- 3. Modificar la tabla educational_levels para vincularla a categorías
ALTER TABLE educational_levels 
ADD COLUMN category_id INT,
ADD CONSTRAINT fk_category FOREIGN KEY (category_id) REFERENCES learning_categories(id);

-- 4. Asignar categorías a niveles existentes (si tienes niveles creados)
UPDATE educational_levels SET category_id = 1 WHERE id BETWEEN 1 AND 3;   -- Fundamentos
UPDATE educational_levels SET category_id = 2 WHERE id BETWEEN 4 AND 6;   -- Cuentas
UPDATE educational_levels SET category_id = 3 WHERE id BETWEEN 7 AND 10;  -- Tarjetas
UPDATE educational_levels SET category_id = 4 WHERE id BETWEEN 11 AND 13; -- Administración
UPDATE educational_levels SET category_id = 5 WHERE id BETWEEN 14 AND 17; -- Deudas

